type Post {
    id: ID!
    content: String!
    comments: [Comment]
}

type Comment {
    id: ID!
    content: String!
    postId: String!
}

type Query {
    getPost(id: ID!) : Post
    getAllPosts : [Post]
}

type Mutation {
    createPost(content: String!) : [Post]
    createComment(content: String!, postId: String!) : [Comment]
}